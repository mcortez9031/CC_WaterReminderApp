<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aquafill"
    android:fitsSystemWindows="true"
    tools:context=".Dashboard">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="3dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/pic" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AquaFill"
            android:textColor="#1E3A5F"
            android:textSize="28sp"
            android:fontFamily="cursive"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="0dp"
        android:paddingTop="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDashboard"
            style="@style/Widget.Material3.Button"
            android:layout_width="145dp"
            android:layout_height="48dp"
            android:text="Dashboard"
            android:textSize="14sp"
            app:backgroundTint="#2E85AE"
            app:cornerRadius="1dp"
            app:icon="@drawable/drinkdash"
            app:iconTint="#1E3A5F"
            app:strokeColor="#1E3A5F"
            app:strokeWidth="0.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHisto"
            style="@style/Widget.Material3.Button"
            android:layout_width="139dp"
            android:layout_height="48dp"
            android:text="History"
            android:textSize="14sp"
            app:icon="@drawable/histdash"
            app:cornerRadius="1dp"
            app:backgroundTint="#7ED6FF"
            app:iconTint="#1E3A5F"
            app:strokeColor="#1E3A5F"
            app:strokeWidth="0.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcc"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Account"
            android:textSize="14sp"
            app:icon="@drawable/acc"
            app:cornerRadius="1dp"
            app:backgroundTint="#7ED6FF"
            app:iconTint="#1E3A5F"
            app:strokeColor="#1E3A5F"
            app:strokeWidth="0.5dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvDashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textColor="#1F2A44"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navBar"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvDashTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:progress="50"
            android:max="100"
            android:progressDrawable="@drawable/progress"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvWaterIntake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1000"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#1E3A5F"
            app:layout_constraintTop_toTopOf="@id/progressBar"
            app:layout_constraintBottom_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="@id/progressBar"
            app:layout_constraintEnd_toEndOf="@id/progressBar" />

        <TextView
            android:id="@+id/tvDailyGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#6B8EBD"
            app:layout_constraintTop_toBottomOf="@id/tvWaterIntake"
            app:layout_constraintStart_toStartOf="@id/progressBar"
            app:layout_constraintEnd_toEndOf="@id/progressBar"
            android:layout_marginTop="4dp" />

        <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="#4794D3"
        app:hintTextColor="#4794D3"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:hint="Amount of Water (ml)"
            android:inputType="number"
            android:textSize="18sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="45dp"
            android:layout_marginStart="45dp" />
        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/progress_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingHorizontal="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Add Water"
            android:textSize="16sp"
            app:icon="@drawable/add_water"
            app:cornerRadius="16dp"
            app:backgroundTint="#4A9FFF"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReminder"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Set Reminder"
            android:textSize="15sp"
            app:icon="@drawable/icon_bell"
            app:cornerRadius="16dp"
            app:backgroundTint="#7ED6FF"
            android:layout_marginStart="12dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
