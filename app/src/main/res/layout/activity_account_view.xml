<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aquafill"
    tools:context=".AccountView"
    android:id="@+id/main">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bgwater"
        android:scaleType="centerCrop"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_aquafill"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="0dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="411dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="40dp"
                android:paddingHorizontal="24dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="3dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    app:srcCompat="@drawable/pic" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AquaFill"
                    android:textColor="#1E3A5F"
                    android:textSize="28sp"
                    android:fontFamily="cursive"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/navBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDashboard"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="145dp"
                    android:layout_height="48dp"
                    android:text="Dashboard"
                    android:textSize="14sp"
                    app:backgroundTint="#7ED6FF"
                    app:cornerRadius="1dp"
                    app:icon="@drawable/drinkdash"
                    app:iconTint="#1E3A5F"
                    app:strokeColor="#1E3A5F"
                    app:strokeWidth="0.5dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHisto"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="139dp"
                    android:layout_height="48dp"
                    android:text="History"
                    android:textSize="14sp"
                    app:icon="@drawable/histdash"
                    app:cornerRadius="1dp"
                    app:backgroundTint="#7ED6FF"
                    app:iconTint="#1E3A5F"
                    app:strokeColor="#1E3A5F"
                    app:strokeWidth="0.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcc"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Account"
                    android:textSize="14sp"
                    app:icon="@drawable/acc"
                    app:cornerRadius="1dp"
                    app:backgroundTint="#2E85AE"
                    app:iconTint="#1E3A5F"
                    app:strokeColor="#1E3A5F"
                    app:strokeWidth="0.5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAccountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account View"
                android:textColor="#1F2A44"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginTop="8dp"
                android:layout_gravity="center" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#C0D9FF"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvFullNameValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColor="#1F2A44"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvEmailValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColor="#1F2A44"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvGenderValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColor="#1F2A44"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Age"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="1dp" >
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvAgeValue"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:textColor="#1F2A44"
                            android:textSize="16sp" />
                        <ImageButton
                            android:id="@+id/btnAgeEdit"
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:src="@drawable/pencil"
                            android:backgroundTint="#C0D9FF">

                        </ImageButton>
                </LinearLayout>>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="1dp" >
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvWeightValue"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColor="#1F2A44"
                        android:textSize="16sp" />
                    <ImageButton
                        android:id="@+id/btnWeightEdit"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:src="@drawable/pencil"
                        android:backgroundTint="#C0D9FF">

                    </ImageButton>
                </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvActivityLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activity Level (Rarely, Light, Moderate, Active)"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="1dp" >
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvActivityLevelValue"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:textColor="#1F2A44"
                        android:textSize="16sp" />
                    <ImageButton
                        android:id="@+id/btnActLvlEdit"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:src="@drawable/pencil"
                        android:backgroundTint="#C0D9FF">

                    </ImageButton>
                </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvWeather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weather (hot, mild, cold)"
                        android:textColor="#7F8C8D"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="1dp" >
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvWeatherValue"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:textColor="#1F2A44"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnWeatherEdit"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:src="@drawable/pencil"
                        android:backgroundTint="#C0D9FF">

                    </ImageButton>
                </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:text="Logout"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#4A9FFF"
        app:cornerRadius="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>